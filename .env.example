# Copy to .env and fill in. .env is gitignored.
# The only external credential this build needs: an OpenRouter API key.
# kagent stores it in one Kubernetes Secret (kagent-openrouter) and every
# ModelConfig points at that Secret.
OPENROUTER_API_KEY=sk-or-v1-<your key>
# Grafana admin password for the kube-prometheus-stack install (any value)
GRAFANA_ADMIN_PASSWORD=<random>
