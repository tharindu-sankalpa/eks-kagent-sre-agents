            "created_at": "2026-10-07T06:11:45.460946Z",
            "updated_at": "2026-10-07T06:13:45.5457Z",
            "description": "Get detailed network connections for a specific workload. Shows all observed ingress and egress traffic with DNS names, IPs, ports, and protocols. Use this to verify if a workload with a vulnerability is actually exposed to the network."
        },
        {
            "id": "kubescape_get_vulnerability_details",
            "server_name": "kagent/kagent-tool-server",
