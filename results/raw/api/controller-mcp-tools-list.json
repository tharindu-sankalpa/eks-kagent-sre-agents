{
    "jsonrpc": "2.0",
    "id": 2,
    "result": {
        "tools": [
            {
                "description": "Invoke a kagent agent via A2A",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "agent": {
                            "type": "string",
                            "description": "Agent reference in format namespace/name. To find a list of available sources, use the 'agents' resource."
                        },
                        "task": {
                            "type": "string",
                            "description": "Task to run"
                        },
                        "context_id": {
                            "type": "string",
                            "description": "Optional A2A context ID to continue a conversation"
                        }
                    },
                    "required": [
                        "agent",
                        "task"
                    ],
                    "additionalProperties": false
                },
                "name": "invoke_agent",
                "outputSchema": {
                    "type": "object",
                    "properties": {
                        "agent": {
                            "type": "string"
                        },
                        "text": {
                            "type": "string"
                        },
                        "context_id": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "agent",
                        "text"
                    ],
                    "additionalProperties": false
                }
            },
            {
                "description": "List invokable kagent agents (accepted + deploymentReady)",
                "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": false
                },
                "name": "list_agents",
                "outputSchema": {
                    "type": "object",
                    "properties": {
                        "agents": {
                            "type": [
                                "null",
                                "array"
                            ],
                            "items": {
                                "type": "object",
                                "properties": {
                                    "ref": {
                                        "type": "string"
                                    },
                                    "description": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "ref"
                                ],
                                "additionalProperties": false
                            }
                        }
                    },
                    "required": [
                        "agents"
                    ],
                    "additionalProperties": false
                }
            }
        ]
    }
}